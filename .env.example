# Copy this to .env and fill in values
SECRET_KEY=your-very-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DATABASE_URL=sqlite:///db.sqlite3
# For production on Render, DATABASE_URL will be set automatically
# CORS: add your frontend URL (Netlify/Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app
